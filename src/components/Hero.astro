---
import { Picture } from 'astro:assets';
import heroImg from '../assets/cars/hero-alphard.jpg';
import BookingForm from './BookingForm.astro';
import { site } from '../config/site';
---

<section class="relative z-10 w-full bg-on-background text-surface-bright" aria-labelledby="hero-title">
  <!-- Visual background image bleed -->
  <div class="absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <Picture
      src={heroImg}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      alt="Toyota Alphard hitam terparkir rapi, siap disewa lepas kunci atau dengan sopir"
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover object-[50%_60%] opacity-40 scale-105 transform motion-safe:transition-transform duration-1000"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-on-background via-on-background/70 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-on-background/90 via-on-background/50 to-transparent"></div>
  </div>

  <!-- Hero Content Container -->
  <div class="relative z-10 max-w-[1280px] mx-auto px-4 sm:px-6 pt-28 pb-16 lg:pt-36 lg:pb-24 flex flex-col gap-8">
    <div class="max-w-2xl flex flex-col gap-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-bright/10 backdrop-blur-md w-fit border border-white/10">
        <span class="w-2 h-2 rounded-full bg-emerald-conversion animate-pulse"></span>
        <span class="font-bold text-xs tracking-wider uppercase text-emerald-conversion">Ready 24/7 {site.city} &amp; Jawa Tengah</span>
      </div>

      <h1 id="hero-title" class="font-extrabold text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.05] text-white">
        Sewa mobil <br class="hidden sm:block" />
        <span class="text-primary-fixed">tanpa ribet</span>
      </h1>

      <p class="text-base sm:text-lg text-outline-variant max-w-xl leading-relaxed">
        Lepas kunci atau dengan sopir di {site.city} dan sekitarnya. Pilih mobil, isi jadwal, admin konfirmasi cepat lewat WhatsApp.
      </p>
    </div>

    <!-- Quick Interactive Booking Form Widget -->
    <BookingForm />
  </div>
</section>
