---
import { getCollection } from 'astro:content';
import IconArrow from '@tabler/icons/outline/arrow-right.svg';
import IconInfo from '@tabler/icons/outline/info-circle.svg';
import FleetCard from './FleetCard.astro';

const cars = (await getCollection('armada', ({ data }) => data.populer && data.tersedia))
  .sort((a, b) => a.data.urutan - b.data.urutan)
  .slice(0, 4);
---

<section class="w-full py-10 bg-surface-subtle" id="armada" aria-labelledby="armada-title">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 flex flex-col gap-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div class="flex flex-col gap-1 max-w-xl">
        <span class="text-xs font-bold uppercase tracking-wider text-primary">ARMADA TERPOPULER</span>
        <h2 id="armada-title" class="font-bold text-2xl leading-8 sm:text-[32px] sm:leading-10 text-on-surface tracking-tight">
          Paling sering disewa
        </h2>
        <p class="text-sm leading-[22px] text-on-surface-variant">
          Mobil terlaris dengan ulasan terbaik, terawat rutin, dan siap menemani perjalanan Anda.
        </p>
      </div>
      <a
        class="inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-primary-container transition-colors group shrink-0"
        href="/armada/"
      >
        <span>Lihat semua armada</span>
        <IconArrow class="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" />
      </a>
    </div>

    <!-- Fleet Grid Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        cars.map((car, i) => (
          <div>
            <FleetCard car={car} highlight={i === 0} />
          </div>
        ))
      }
    </div>

    <!-- Pricing clarity banner note -->
    <div class="flex items-center justify-center gap-2 p-4 rounded-lg bg-surface-container-low text-on-surface-variant text-xs leading-[18px] text-center">
      <IconInfo class="w-4 h-4 text-primary shrink-0" aria-hidden="true" />
      <span>Harga mulai per 24 jam untuk lepas kunci atau per 12 jam dengan sopir. Belum termasuk BBM, tol, dan parkir.</span>
    </div>
  </div>
</section>
