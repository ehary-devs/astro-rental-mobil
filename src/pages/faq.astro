<script>
  function initFaqPage() {
    const form = document.getElementById('faqSearchForm') as HTMLFormElement | null;
    const searchInput = document.getElementById('faqSearchInput') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clearSearchBtn');
    const items = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-nav-btn');
    const quickCards = document.querySelectorAll<HTMLButtonElement>('[data-cat-trigger]');
    const quickTags = document.querySelectorAll<HTMLButtonElement>('[data-quick-tag]');
    const title = document.getElementById('currentTopicTitle');
    const resultCount = document.getElementById('resultCount');
    const emptyState = document.getElementById('noFaqResults');
    const section = document.getElementById('faqAccordionSection');

    let currentCategory = 'all';
    const titleMap: Record<string, string> = {
      all: 'Semua Pertanyaan',
      booking: 'Reservasi & Pembayaran',
      syarat: 'Persyaratan & Dokumen',
      operasional: 'Aturan Selama Sewa',
      darurat: 'Bantuan & Darurat',
    };

    const scrollToList = () => section?.scrollIntoView({ behavior: 'smooth', block: 'start' });

    function updateView() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const words = query.split(/\s+/).filter(Boolean);
      let visible = 0;

      clearBtn?.classList.toggle('hidden', query.length === 0);

      items.forEach((item) => {
        const cat = item.dataset.category || '';
        const haystack = `${item.textContent || ''} ${item.dataset.keywords || ''}`.toLowerCase();
        const matchesCat = query !== '' || currentCategory === 'all' || cat === currentCategory;
        const matchesQuery = words.every((w) => haystack.includes(w));
        const show = matchesCat && matchesQuery;
        item.classList.toggle('hidden', !show);
        if (show) visible++;
      });

      if (title) title.textContent = query ? `Hasil Pencarian: "${query}"` : titleMap[currentCategory] || 'Daftar Pertanyaan';
      if (resultCount) resultCount.textContent = `Menampilkan ${visible} pertanyaan`;
      if (emptyState) {
        emptyState.classList.toggle('hidden', visible > 0);
        emptyState.classList.toggle('flex', visible === 0);
      }

      catButtons.forEach((btn) => {
        const active = btn.dataset.catBtn === currentCategory && !query;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('bg-primary-fixed', active);
        btn.classList.toggle('text-on-primary-fixed', active);
        btn.classList.toggle('font-bold', active);
        btn.classList.toggle('text-on-surface-variant', !active);
      });
    }

    function setCategory(cat: string, scroll = false) {
      currentCategory = cat;
      if (searchInput) searchInput.value = '';
      updateView();
      if (scroll) scrollToList();
    }

    catButtons.forEach((btn) => btn.addEventListener('click', () => setCategory(btn.dataset.catBtn || 'all')));
    quickCards.forEach((card) => card.addEventListener('click', () => setCategory(card.dataset.catTrigger || 'all', true)));

    searchInput?.addEventListener('input', updateView);
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      updateView();
      scrollToList();
    });
    clearBtn?.addEventListener('click', () => {
      setCategory('all');
      searchInput?.focus();
    });
    quickTags.forEach((btn) =>
      btn.addEventListener('click', () => {
        if (!searchInput) return;
        searchInput.value = btn.dataset.quickTag || '';
        updateView();
        scrollToList();
      }),
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqPage);
  } else {
    initFaqPage();
  }
</script>

