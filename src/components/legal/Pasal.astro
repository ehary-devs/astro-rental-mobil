---
/** Kartu satu pasal/bagian bernomor. Isi lewat slot. */
type Icon = (props: Record<string, unknown>) => unknown;
interface Props {
  id: string;
  num: number;
  title: string;
  icon: Icon;
  /** Label kecil di atas judul. Default: "Pasal N". */
  eyebrow?: string;
}
const { id, num, title, icon: PasalIcon, eyebrow = `Pasal ${num}` } = Astro.props;
---

<article id={id} class="scroll-mt-28 p-6 sm:p-10 rounded-xl bg-surface-container-lowest shadow-sm border border-border-subtle/60 break-inside-avoid" aria-labelledby={`${id}-title`}>
  <div class="flex items-start justify-between gap-4 mb-4">
    <div class="flex items-center gap-3">
      <span class="w-10 h-10 shrink-0 rounded-lg bg-surface-container-high text-primary flex items-center justify-center text-lg font-bold tabular-nums" aria-hidden="true">{String(num).padStart(2, '0')}</span>
      <div>
        <span class="text-xs text-primary uppercase font-bold tracking-wider">{eyebrow}</span>
        <h2 id={`${id}-title`} class="text-lg sm:text-[22px] sm:leading-7 font-semibold text-on-surface">{title}</h2>
      </div>
    </div>
    <span class="hidden sm:flex w-10 h-10 shrink-0 rounded-full bg-primary-fixed/60 text-primary items-center justify-center" aria-hidden="true">
      <PasalIcon class="w-5 h-5" />
    </span>
  </div>
  <div class="flex flex-col gap-4 text-sm leading-[22px] text-on-surface-variant">
    <slot />
  </div>
</article>
