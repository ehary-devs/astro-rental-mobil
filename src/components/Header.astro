---
import IconWa from '@tabler/icons/outline/brand-whatsapp.svg';
import IconMenu from '@tabler/icons/outline/menu-2.svg';
import IconX from '@tabler/icons/outline/x.svg';
import IconChevron from '@tabler/icons/outline/chevron-down.svg';
import Logo from './Logo.astro';
import { waGreeting, waLink } from '../config/site';
import { kota, layanan, rute } from '../data/halaman';

type Link = { href: string; label: string };
type Group = { title?: string; links: Link[] };
type Item = { label: string; href?: string; match: string[]; groups?: Group[] };

const toLinks = (base: string, list: { slug: string; nama: string }[]): Link[] =>
  list.map((p) => ({ href: `/${base}/${p.slug}/`, label: p.nama }));

const nav: Item[] = [
  { label: 'Beranda', href: '/', match: ['/'] },
  { label: 'Armada', href: '/armada/', match: ['/armada/'] },
  { label: 'Layanan', match: ['/layanan/'], groups: [{ links: toLinks('layanan', layanan) }] },
  {
    label: 'Area & Rute',
    match: ['/kota/', '/rute/'],
    groups: [
      { title: 'Kota layanan', links: toLinks('kota', kota) },
      { title: 'Rute populer', links: toLinks('rute', rute) },
    ],
  },
  { label: 'Promo', href: '/#promo', match: [] },
  { label: 'FAQ', href: '/faq/', match: ['/faq/'] },
  { label: 'Kontak', href: '/kontak/', match: ['/kontak/'] },
];

const path = Astro.url.pathname;
const isActive = (item: Item) => {
  if (item.href === '/') return path === '/';
  return item.match.some((m) => path.startsWith(m));
};
---

<header class="header fixed top-0 left-0 w-full z-50 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] border-b border-border-subtle/50 transition-all">
  <div class="h-20 max-w-[1280px] mx-auto px-4 sm:px-6 flex items-center justify-between gap-4">
    <a href="/" class="brand-link" aria-label="Beranda">
      <Logo />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Navigasi utama">
      {
        nav.map((item, i) => {
          const active = isActive(item);
          return (
            <div class="relative group/nav">
              {item.groups ? (
                <>
                  <button
                    type="button"
                    class:list={[
                      'px-3.5 py-2 font-semibold text-sm transition-colors rounded-lg inline-flex items-center gap-1 cursor-pointer select-none',
                      active
                        ? 'bg-surface-container-high text-primary font-bold'
                        : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container',
                    ]}
                    aria-expanded="false"
                    aria-controls={`dd-${i}`}
                    data-dropdown-toggle
                  >
                    <span>{item.label}</span>
                    <IconChevron aria-hidden="true" class="w-4 h-4 transition-transform group-hover/nav:rotate-180 duration-200" />
                  </button>
                  <div
                    class:list={[
                      'dropdown absolute top-full left-0 mt-2 p-2 bg-surface-container-lowest border border-border-subtle rounded-2xl shadow-[0_20px_50px_rgba(15,23,42,0.12)] opacity-0 invisible group-hover/nav:opacity-100 group-hover/nav:visible transition-all duration-200 z-50 transform -translate-y-2 group-hover/nav:translate-y-0',
                      item.groups.length > 1 ? 'min-w-[480px] grid grid-cols-2 gap-2 p-3' : 'min-w-[240px]',
                    ]}
                    id={`dd-${i}`}
                    data-dropdown
                  >
                    {item.groups.map((g) => (
                      <div class="dd-group">
                        {g.title && <p class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-text-muted">{g.title}</p>}
                        <ul class="flex flex-col gap-0.5">
                          {g.links.map((l) => (
                            <li>
                              <a
                                href={l.href}
                                aria-current={l.href === path ? 'page' : undefined}
                                class:list={[
                                  'block px-3 py-2 rounded-xl text-sm font-medium transition-colors',
                                  l.href === path
                                    ? 'bg-primary-fixed text-on-primary-fixed font-bold'
                                    : 'text-on-surface hover:bg-surface-container hover:text-primary',
                                ]}
                              >
                                {l.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </>
              ) : (
                <a
                  class:list={[
                    'px-3.5 py-2 font-semibold text-sm transition-colors rounded-lg inline-block',
                    active
                      ? 'bg-surface-container-high text-primary font-bold'
                      : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container',
                  ]}
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              )}
            </div>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        class="hidden sm:inline-flex items-center gap-2 bg-emerald-conversion hover:bg-emerald-deep text-white px-4 py-2.5 rounded-xl font-bold text-sm shadow-[0_2px_10px_rgba(16,185,129,0.25)] transition-all hover:scale-[1.02] active:scale-[0.98]"
        href={waLink(waGreeting)}
        target="_blank"
        rel="noopener noreferrer"
      >
        <IconWa class="w-5 h-5" aria-hidden="true" />
        Chat Admin
      </a>

      <!-- Mobile Menu Toggle Button -->
      <details class="menu lg:hidden relative" data-mobile-menu>
        <summary
          aria-label="Buka menu navigasi"
          class="list-none w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high cursor-pointer transition-colors"
        >
          <IconMenu aria-hidden="true" class="w-5 h-5 ic-open" />
          <IconX aria-hidden="true" class="w-5 h-5 ic-close hidden" />
        </summary>
        <div class="panel fixed left-3 right-3 top-[calc(var(--header-h)+8px)] max-h-[calc(100dvh-var(--header-h)-24px)] overflow-y-auto p-3 bg-surface-container-lowest border border-border-subtle rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.2)] z-50">
          <ul class="flex flex-col">
            {
              [...nav.filter((n) => !n.groups), ...nav.filter((n) => n.groups)].map((item) =>
                item.groups ? (
                  item.groups.map((g) => (
                    <li class="mt-2 pt-3 px-1 border-t border-border-subtle">
                      <p class="px-2 text-xs font-bold uppercase tracking-wider text-text-muted mb-2">{g.title ?? item.label}</p>
                      <div class="flex flex-wrap gap-1.5 px-1 pb-1">
                        {g.links.map((l) => (
                          <a
                            href={l.href}
                            aria-current={l.href === path ? 'page' : undefined}
                            class:list={[
                              'px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                              l.href === path
                                ? 'bg-primary text-white'
                                : 'bg-surface-container text-on-surface hover:bg-surface-container-high',
                            ]}
                          >
                            {l.label}
                          </a>
                        ))}
                      </div>
                    </li>
                  ))
                ) : (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item) ? 'page' : undefined}
                      class:list={[
                        'flex items-center min-h-11 px-3 rounded-xl text-[15px] font-semibold transition-colors',
                        isActive(item)
                          ? 'bg-surface-container-high text-primary'
                          : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ),
              )
            }
          </ul>
          <a
            class="mt-4 flex items-center justify-center gap-2 bg-emerald-conversion hover:bg-emerald-deep text-white px-4 py-3 rounded-xl font-bold text-sm shadow-[0_2px_10px_rgba(16,185,129,0.25)] transition-all"
            href={waLink(waGreeting)}
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconWa class="w-5 h-5" aria-hidden="true" />
            Chat Admin WhatsApp
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Mobile menu close on click outside or escape
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if (menu) {
    const summary = menu.querySelector('summary');
    const openIcon = menu.querySelector('.ic-open');
    const closeIcon = menu.querySelector('.ic-close');

    menu.addEventListener('toggle', () => {
      const isOpen = menu.open;
      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden', isOpen);
        closeIcon.classList.toggle('hidden', !isOpen);
      }
    });

    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) {
        menu.open = false;
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
  }

  // Keyboard navigation for dropdown
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-dropdown-toggle]');
  toggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
    });
  });
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
