---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import IconUsers from '@tabler/icons/outline/users.svg';
import IconManual from '@tabler/icons/outline/manual-gearbox.svg';
import IconAuto from '@tabler/icons/outline/automatic-gearbox.svg';
import IconFuel from '@tabler/icons/outline/gas-station.svg';
import IconBolt from '@tabler/icons/outline/bolt.svg';
import IconLeaf from '@tabler/icons/outline/leaf.svg';
import IconKey from '@tabler/icons/outline/key.svg';
import IconSteering from '@tabler/icons/outline/steering-wheel.svg';
import IconWa from '@tabler/icons/outline/brand-whatsapp.svg';
import { KATEGORI } from '../content.config';
import { formatHargaLengkap, site, WA_SOURCE_TAG, waLink } from '../config/site';

interface Props {
  car: CollectionEntry<'armada'>;
  highlight?: boolean;
  /** Tampilkan satu baris deskripsi dari isi markdown. Default true. */
  showDescription?: boolean;
  /** Atribut loading gambar, mis. 'eager' untuk kartu di atas lipatan. */
  loading?: 'lazy' | 'eager';
}

const { car, highlight = false, showDescription = true, loading = 'lazy' } = Astro.props;
const { nama, kategori, gambar, alt, kapasitas, transmisi, bbm, harga, populer, tersedia } = car.data;

// Tampilkan harga termurah yang tersedia. Lepas kunci per 24 jam, dengan sopir per 12 jam.
const opsi = [
  harga.lepasKunci ? { nilai: harga.lepasKunci, label: 'Lepas kunci', durasi: '24 jam' } : null,
  harga.denganSopir ? { nilai: harga.denganSopir, label: 'Dengan sopir', durasi: '12 jam' } : null,
].filter((o): o is { nilai: number; label: string; durasi: string } => o !== null);
const termurah = opsi.reduce((a, b) => (b.nilai < a.nilai ? b : a));

// Deskripsi singkat: kalimat pertama dari body markdown.
const deskripsi = showDescription ? (car.body ?? '').trim().split(/(?<=\.)\s/)[0] : '';

const transmisiLabel = { manual: 'Manual', matic: 'Matic', 'manual/matic': 'Manual/Matic' }[transmisi];
const bbmLabel = { bensin: 'Bensin', solar: 'Solar (Diesel)', hybrid: 'Hybrid', listrik: 'Listrik (EV)' }[bbm];
const BbmIcon = bbm === 'listrik' ? IconBolt : bbm === 'hybrid' ? IconLeaf : IconFuel;
const layanan =
  harga.lepasKunci && harga.denganSopir
    ? { label: 'Kunci & sopir', icon: IconKey }
    : harga.lepasKunci
      ? { label: 'Lepas kunci', icon: IconKey }
      : { label: 'Dengan sopir', icon: IconSteering };

const specs = [
  { icon: IconUsers, label: `${kapasitas} Kursi` },
  { icon: transmisi === 'manual' ? IconManual : IconAuto, label: transmisiLabel },
  { icon: BbmIcon, label: bbmLabel },
  { icon: layanan.icon, label: layanan.label },
];

const promo = site.promo.active && site.promo.car === nama ? `Promo diskon ${site.promo.value}` : null;
const pesan = `Halo Admin ${site.name}, saya mau sewa ${nama}. ${WA_SOURCE_TAG}`;
const href = `/armada/${car.id}/`;
---

<article
  class:list={[
    'card group flex flex-col h-full bg-surface-container-lowest rounded-2xl overflow-hidden border border-border-subtle shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300',
    { 'ring-2 ring-primary/30': highlight },
  ]}
>
  <!-- Foto -->
  <a href={href} class="relative block aspect-[16/10] overflow-hidden bg-surface-container" aria-label={`Detail armada ${nama}`}>
    <Image
      src={gambar}
      alt={alt}
      widths={[360, 540, 760]}
      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 300px"
      loading={loading}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <span class="absolute top-3 left-3 right-3 flex flex-wrap gap-1.5">
      <span class="px-2.5 py-1 rounded-md bg-on-background/85 backdrop-blur-sm text-white text-[11px] font-bold uppercase tracking-wide">
        {KATEGORI[kategori]}
      </span>
      {populer && <span class="px-2.5 py-1 rounded-md bg-primary-container text-white text-[11px] font-bold shadow-sm">Terpopuler</span>}
      {promo && <span class="px-2.5 py-1 rounded-md bg-emerald-conversion text-white text-[11px] font-bold shadow-sm">{promo}</span>}
    </span>
    {
      tersedia && (
        <span class="absolute bottom-2.5 right-2.5 bg-surface-container-lowest/90 backdrop-blur-sm px-2 py-0.5 rounded text-[11px] font-semibold text-emerald-deep flex items-center gap-1 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-conversion" aria-hidden="true" /> Unit siap
        </span>
      )
    }
  </a>

  <!-- Isi -->
  <div class="p-4 sm:p-5 flex-1 flex flex-col">
    <h3 class="font-bold text-lg text-on-surface tracking-tight leading-snug group-hover:text-primary transition-colors">
      <a href={href} class="focus-visible:outline-none focus-visible:underline">{nama}</a>
    </h3>
    {deskripsi && <p class="mt-1 text-[13px] text-on-surface-variant line-clamp-1" title={deskripsi}>{deskripsi}</p>}

    <ul class="grid grid-cols-2 gap-2 mt-3 list-none p-0" aria-label="Spesifikasi">
      {
        specs.map((s) => (
          <li class="flex items-center gap-1.5 px-2 py-1.5 rounded-lg bg-surface-container-low text-xs font-medium text-on-surface min-w-0">
            <s.icon class="w-4 h-4 text-primary shrink-0" aria-hidden="true" />
            <span class="leading-tight">{s.label}</span>
          </li>
        ))
      }
    </ul>

    <!-- Harga & aksi -->
    <div class="mt-auto pt-4 flex flex-col gap-3">
      <div class="flex flex-col gap-0.5">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs text-text-muted">Mulai dari</span>
          <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-secondary-fixed text-on-secondary-fixed whitespace-nowrap" aria-hidden="true">
            {termurah.label}
          </span>
        </div>
        <span class="visually-hidden">{formatHargaLengkap(termurah.nilai)} per {termurah.durasi}, {termurah.label.toLowerCase()}</span>
        <span class="flex items-baseline gap-1" aria-hidden="true">
          <span class="font-extrabold text-xl text-primary leading-tight whitespace-nowrap">{formatHargaLengkap(termurah.nilai)}</span>
          <span class="text-xs text-on-surface-variant whitespace-nowrap">/ {termurah.durasi}</span>
        </span>
      </div>

      <a
        class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-emerald-conversion hover:bg-emerald-deep text-white font-bold text-sm shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-deep focus-visible:ring-offset-2"
        href={waLink(pesan)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Pesan ${nama} via WhatsApp`}
      >
        <IconWa class="w-[18px] h-[18px]" aria-hidden="true" />
        Pesan via WA
      </a>
    </div>
  </div>
</article>
