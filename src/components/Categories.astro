---
import { Image } from 'astro:assets';
import IconArrow from '@tabler/icons/outline/arrow-up-right.svg';
import avanza from '../assets/cars/avanza.jpg';
import fortuner from '../assets/cars/fortuner.jpg';
import brio from '../assets/cars/brio.jpg';
import hiace from '../assets/cars/hiace-bali.jpg';

const items = [
  {
    slug: 'mpv',
    title: 'MPV Keluarga',
    badge: '7 Kursi',
    desc: 'Nyaman untuk keluarga & koper',
    img: avanza,
    alt: 'Toyota Avanza MPV Keluarga',
  },
  {
    slug: 'suv',
    title: 'SUV Tangguh',
    badge: 'Gagah & Luas',
    desc: 'Siap segala medan rute luar kota',
    img: fortuner,
    alt: 'Toyota Fortuner SUV Tangguh',
  },
  {
    slug: 'city-car',
    title: 'City Car',
    badge: '5 Kursi • Irit',
    desc: 'Lincah & hemat untuk keliling kota',
    img: brio,
    alt: 'Honda Brio City Car',
  },
  {
    slug: 'minibus',
    title: 'Minibus Rombongan',
    badge: '14-16 Kursi',
    desc: 'Pas untuk rombongan wisata & dinas',
    img: hiace,
    alt: 'Toyota HiAce Minibus Rombongan',
  },
];
---

<section class="w-full py-10 bg-surface" id="kategori" aria-labelledby="kategori-title">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 flex flex-col gap-6">
    <div class="flex flex-col gap-1 max-w-xl">
      <span class="text-xs font-bold uppercase tracking-wider text-primary">PILIHAN KATEGORI</span>
      <h2 id="kategori-title" class="font-bold text-2xl leading-8 sm:text-[32px] sm:leading-10 text-on-surface tracking-tight">
        Pilih sesuai rombongan
      </h2>
      <p class="text-sm leading-[22px] text-on-surface-variant">
        Pilihan armada lengkap dari mobil harian lincah hingga minibus untuk rombongan.
      </p>
    </div>

    <!-- 4 Bespoke Grid Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        items.map((item) => (
          <a
            class="group relative h-72 sm:h-96 rounded-lg overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between p-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href={`/armada/#${item.slug}`}
          >
            <!-- Background Image -->
            <div class="absolute inset-0 z-0 overflow-hidden bg-on-background">
              <Image
                src={item.img}
                alt={item.alt}
                widths={[320, 480, 640]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 300px"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-100"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-on-background via-on-background/30 to-transparent" />
            </div>

            <!-- Top Pill -->
            <div class="relative z-10 self-start">
              <span class="px-3 py-1 rounded-full bg-surface-bright/80 backdrop-blur-md text-on-surface text-xs font-semibold shadow-sm inline-block">
                {item.badge}
              </span>
            </div>

            <!-- Bottom Content -->
            <div class="relative z-10 flex items-end justify-between gap-3">
              <div class="flex flex-col">
                <span class="font-bold text-xl leading-7 text-surface-bright">
                  {item.title}
                </span>
                <span class="text-xs leading-[18px] text-surface-container-highest line-clamp-1">
                  {item.desc}
                </span>
              </div>
              <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white group-hover:bg-primary group-hover:text-white transition-colors shrink-0">
                <IconArrow class="w-5 h-5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 duration-200" aria-hidden="true" />
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
