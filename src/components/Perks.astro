---
import IconWa from '@tabler/icons/outline/brand-whatsapp.svg';
import IconWheel from '@tabler/icons/outline/steering-wheel.svg';
import IconRepeat from '@tabler/icons/outline/calendar-repeat.svg';
import IconReceipt from '@tabler/icons/outline/receipt.svg';

const perks = [
  {
    icon: IconWa,
    iconBg: 'bg-emerald-conversion/20 text-emerald-conversion',
    title: 'Booking Praktis via WA',
    desc: 'Cukup chat admin WhatsApp tanpa perlu isi formulir ribet atau registrasi akun.',
  },
  {
    icon: IconWheel,
    iconBg: 'bg-primary-container/30 text-primary-fixed',
    title: 'Sopir Ramah & Hafal Rute',
    desc: 'Pengemudi berlisensi, tepat waktu, dan menguasai rute wisata maupun jalur alternatif.',
  },
  {
    icon: IconRepeat,
    iconBg: 'bg-primary-fixed/20 text-primary-fixed-dim',
    title: 'Jadwal Fleksibel',
    desc: 'Bebas ubah tanggal dan jam penjemputan tanpa penalti, maksimal konfirmasi H-1.',
  },
  {
    icon: IconReceipt,
    iconBg: 'bg-emerald-deep/30 text-emerald-conversion',
    title: 'Harga Jujur & Pasti',
    desc: 'Biaya sewa transparan disepakati di awal tanpa biaya siluman saat perjalanan selesai.',
  },
];
---

<section class="w-full py-10 bg-inverse-surface text-surface-bright" id="keunggulan" aria-labelledby="keunggulan-title">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 flex flex-col gap-6">
    <div class="flex flex-col gap-1 max-w-xl">
      <span class="text-xs font-bold uppercase tracking-wider text-primary-fixed-dim">KEUNGGULAN LAYANAN</span>
      <h2 id="keunggulan-title" class="font-bold text-2xl leading-8 sm:text-[32px] sm:leading-10 text-white tracking-tight">
        Kenapa rental di Lintas Rent?
      </h2>
      <p class="text-sm leading-[22px] text-outline-variant">
        Prioritas kami adalah kenyamanan, keselamatan, dan kepastian perjalanan Anda.
      </p>
    </div>

    <!-- 4 Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        perks.map(({ icon: Icon, iconBg, title, desc }) => (
          <div class="p-6 rounded-lg bg-surface-bright/5 hover:bg-surface-bright/10 transition-colors flex flex-col gap-2 backdrop-blur-sm">
            <div class:list={['w-12 h-12 rounded-lg flex items-center justify-center shrink-0', iconBg]}>
              <Icon class="w-6 h-6" aria-hidden="true" />
            </div>
            <h3 class="font-semibold text-lg leading-6 text-surface-bright">
              {title}
            </h3>
            <p class="text-xs text-outline-variant leading-relaxed">
              {desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
