---
import IconPin from '@tabler/icons/outline/map-pin.svg';
import IconClock from '@tabler/icons/outline/clock.svg';
import IconPhone from '@tabler/icons/outline/phone.svg';
import IconMail from '@tabler/icons/outline/mail.svg';
import IconInstagram from '@tabler/icons/outline/brand-instagram.svg';
import IconFacebook from '@tabler/icons/outline/brand-facebook.svg';
import IconTiktok from '@tabler/icons/outline/brand-tiktok.svg';
import IconYoutube from '@tabler/icons/outline/brand-youtube.svg';
import Logo from './Logo.astro';
import { site } from '../config/site';
import { kota, layanan, rute } from '../data/halaman';

const socialIcons = { instagram: IconInstagram, facebook: IconFacebook, tiktok: IconTiktok, youtube: IconYoutube };
const year = new Date().getFullYear();

const toLinks = (base: string, list: { slug: string; nama: string }[]) =>
  list.map((p) => ({ href: `/${base}/${p.slug}/`, label: p.nama }));

const columns = [
  { title: 'Layanan Rental', items: toLinks('layanan', layanan) },
  { title: 'Kota Layanan', items: toLinks('kota', kota) },
  { title: 'Rute Populer', items: toLinks('rute', rute) },
];
---

<footer class="w-full bg-surface-container-low text-on-surface pt-16 pb-12 border-t border-border-subtle shadow-[0_-1px_12px_rgba(0,0,0,0.02)]" id="kontak">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10 pb-12 border-b border-surface-container-highest">
      <!-- Brand & Info Column (2 cols) -->
      <div class="lg:col-span-2 flex flex-col gap-4 pr-0 lg:pr-6">
        <a href="/" aria-label="Beranda">
          <Logo />
        </a>
        <p class="text-sm text-on-surface-variant max-w-sm leading-relaxed">
          Penyedia solusi rental mobil terpercaya di {site.city} dan sekitarnya. Melayani lepas kunci, sewa dengan pengemudi profesional, perjalanan dinas korporat, hingga pariwisata Jawa Tengah.
        </p>

        <div class="flex flex-col gap-2.5 text-xs text-on-surface-variant mt-1">
          <div class="flex items-start gap-2">
            <IconPin class="w-4 h-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
              {site.address}
            </a>
          </div>
          <div class="flex items-center gap-2">
            <IconClock class="w-4 h-4 text-primary shrink-0" aria-hidden="true" />
            <span>Jam Operasional: {site.hours}</span>
          </div>
          <div class="flex items-center gap-2">
            <IconPhone class="w-4 h-4 text-primary shrink-0" aria-hidden="true" />
            <a href={`tel:+${site.whatsapp}`} class="hover:text-primary transition-colors">
              {site.phoneDisplay}
            </a>
          </div>
          <div class="flex items-center gap-2">
            <IconMail class="w-4 h-4 text-primary shrink-0" aria-hidden="true" />
            <a href={`mailto:${site.email}`} class="hover:text-primary transition-colors">
              {site.email}
            </a>
          </div>
        </div>

        {
          site.social.length > 0 && (
            <div class="flex items-center gap-2 mt-2">
              {site.social.map((s) => {
                const Icon = socialIcons[s.icon];
                return (
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.label}
                    class="w-8 h-8 rounded-lg bg-surface-container hover:bg-primary hover:text-white text-on-surface-variant flex items-center justify-center transition-colors"
                  >
                    <Icon class="w-4 h-4" aria-hidden="true" />
                  </a>
                );
              })}
            </div>
          )
        }
      </div>

      <!-- Nav Columns (3 cols) -->
      {
        columns.map((col) => (
          <div class="flex flex-col gap-3">
            <h4 class="font-bold text-sm text-on-surface">{col.title}</h4>
            <ul class="flex flex-col gap-2 text-xs text-on-surface-variant">
              {col.items.map((item) => (
                <li>
                  <a href={item.href} class="hover:text-primary transition-colors block py-0.5">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-on-surface-variant">
      <p>&copy; {year} PT Lintas Mobilitas Nusantara ({site.name}). Seluruh hak cipta dilindungi undang-undang.</p>
      <div class="flex items-center gap-5 flex-wrap">
        <a href="/armada/" class="hover:text-primary transition-colors">Katalog Armada</a>
        <a href="/syarat-ketentuan/" class="hover:text-primary transition-colors">Syarat &amp; Ketentuan</a>
        <a href="/kebijakan-privasi/" class="hover:text-primary transition-colors">Kebijakan Privasi</a>
        <a href="/faq/" class="hover:text-primary transition-colors">Pusat Bantuan &amp; FAQ</a>
        <a href="/kredit-foto/" class="hover:text-primary transition-colors">Kredit Foto</a>
      </div>
    </div>
  </div>
</footer>
