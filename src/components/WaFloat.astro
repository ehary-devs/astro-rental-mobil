---
import IconWa from '@tabler/icons/outline/brand-whatsapp.svg';
import { waGreeting, waLink } from '../config/site';
---

<!-- Hanya di HP: di layar sm+ sudah ada tombol "Chat Admin" di header. -->
<aside class="fixed bottom-4 right-4 z-40 sm:hidden" data-wa-float>
  <a
    class="flex items-center justify-center w-14 h-14 bg-emerald-conversion hover:bg-emerald-deep text-white rounded-full shadow-[0_8px_24px_rgba(16,185,129,0.35)] transition-transform active:scale-95 select-none"
    href={waLink(waGreeting)}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat admin lewat WhatsApp"
  >
    <IconWa class="w-7 h-7" aria-hidden="true" />
  </a>
</aside>

<script>
  // Sembunyikan saat form booking (yang punya tombol WA sendiri) sedang terlihat.
  const container = document.querySelector<HTMLElement>('[data-wa-float]');
  const heroForm = document.querySelector('#pesan');

  if (container && heroForm && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => {
        const hide = Boolean(entry?.isIntersecting);
        container.classList.toggle('opacity-0', hide);
        container.classList.toggle('pointer-events-none', hide);
        container.classList.toggle('translate-y-4', hide);
      },
      { threshold: 0.15 }
    ).observe(heroForm);
  }
</script>

<style>
  [data-wa-float] {
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
</style>
