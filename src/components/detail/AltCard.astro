---
/** Kartu ringkas "Armada alternatif" di halaman detail. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import IconChevronRight from '@tabler/icons/outline/chevron-right.svg';
import { KATEGORI } from '../../content.config';
import { formatHargaLengkap } from '../../config/site';

interface Props {
  car: CollectionEntry<'armada'>;
}

const { car } = Astro.props;
const { nama, kategori, gambar, alt, kapasitas, transmisi, bbm, harga, populer } = car.data;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const opsi = [
  harga.lepasKunci ? { nilai: harga.lepasKunci, unit: '/24 jam', label: 'Lepas kunci' } : null,
  harga.denganSopir ? { nilai: harga.denganSopir, unit: '/12 jam', label: 'Dengan sopir' } : null,
].filter((o): o is { nilai: number; unit: string; label: string } => o !== null);
const termurah = opsi.reduce((a, b) => (b.nilai < a.nilai ? b : a));
const href = `/armada/${car.id}/`;
const mode = harga.lepasKunci && harga.denganSopir ? 'Lepas kunci & dengan sopir' : harga.denganSopir ? 'Khusus dengan sopir' : 'Lepas kunci';
---

<article class="group relative bg-surface-container-lowest rounded-2xl overflow-hidden border border-border-subtle shadow-sm hover:shadow-md transition-shadow flex flex-col h-full">
  <div class="relative h-44 w-full bg-surface-container overflow-hidden">
    <Image
      src={gambar}
      alt={alt}
      widths={[320, 480, 640]}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 300px"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <span
      class:list={[
        'absolute top-3 left-3 px-2 py-0.5 rounded text-[11px] font-bold shadow-sm',
        populer ? 'bg-primary text-on-primary' : 'bg-surface-container-lowest/90 text-on-surface',
      ]}
    >
      {populer ? 'Populer' : KATEGORI[kategori]}
    </span>
  </div>
  <div class="p-4 flex flex-col justify-between grow">
    <div>
      <span class="text-[11px] font-medium text-text-muted">{mode}</span>
      <h3 class="font-bold text-base text-on-surface mt-0.5">
        <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{nama}</a>
      </h3>
      <p class="text-xs text-text-muted mt-1">
        {kapasitas} kursi &bull; {cap(transmisi)} &bull; {cap(bbm)}
      </p>
    </div>
    <div class="pt-3 mt-3 border-t border-surface-container flex items-center justify-between gap-2">
      <div>
        <span class="text-[11px] text-text-muted block">Mulai dari ({termurah.label.toLowerCase()})</span>
        <span class="font-bold text-primary text-base tabular-nums">
          {formatHargaLengkap(termurah.nilai)}<span class="text-xs font-normal text-text-muted">{termurah.unit}</span>
        </span>
      </div>
      <span class="p-2 rounded-lg bg-surface-container-low text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors" aria-hidden="true">
        <IconChevronRight class="w-5 h-5" />
      </span>
    </div>
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
