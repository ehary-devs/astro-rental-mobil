---
/** Rute populer yang cocok untuk mobil ini (dari src/data/halaman.ts), tautan ke /rute/<slug>/. */
import type { CollectionEntry } from 'astro:content';
import IconRoute from '@tabler/icons/outline/route.svg';
import IconClock from '@tabler/icons/outline/clock.svg';
import IconArrowRight from '@tabler/icons/outline/arrow-right.svg';
import { rute } from '../../data/halaman';

interface Props {
  car: CollectionEntry<'armada'>;
}

const { car } = Astro.props;
const list = rute.filter((r) => (r.filterMobil ? r.filterMobil(car) : true)).slice(0, 4);
const cols = list.length >= 4 ? 'lg:grid-cols-4' : list.length === 3 ? 'lg:grid-cols-3' : '';
---

{
  list.length > 0 && (
    <section class="w-full bg-surface py-14 lg:py-20" aria-labelledby="rute-title">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-3">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-primary">Inspirasi perjalanan</span>
            <h2 id="rute-title" class="font-bold text-2xl sm:text-3xl text-on-surface tracking-tight mt-1">
              Rute Populer yang Cocok untuk {car.data.nama}
            </h2>
          </div>
          <p class="text-sm text-text-muted max-w-md">
            Perkiraan jarak dan waktu tempuh dalam kondisi normal. Admin bantu atur jadwal berangkat.
          </p>
        </div>

        <div class:list={['grid grid-cols-1 sm:grid-cols-2 gap-5', cols]}>
          {list.map((r) => (
            <article class="group relative bg-surface-container-lowest rounded-2xl overflow-hidden border border-border-subtle shadow-sm hover:shadow-md transition-shadow flex flex-col">
              <div class="relative h-32 w-full bg-gradient-to-br from-primary to-primary-container text-on-primary p-4 flex flex-col justify-end overflow-hidden">
                <IconRoute class="absolute -right-4 -top-4 w-32 h-32 text-white/10" aria-hidden="true" />
                <span class="absolute top-3 left-3 inline-flex items-center gap-1 bg-surface-container-lowest/95 px-2.5 py-1 rounded text-xs font-bold text-primary">
                  <IconClock class="w-3.5 h-3.5" aria-hidden="true" />
                  {r.waktu}
                </span>
                <p class="relative text-xs font-semibold text-on-primary-container">
                  {r.dari} <span aria-hidden="true">&rarr;</span><span class="sr-only">ke</span> {r.ke}
                </p>
              </div>
              <div class="p-4 flex flex-col justify-between grow">
                <div>
                  <h3 class="font-bold text-base text-on-surface">
                    <a href={`/rute/${r.slug}/`} class="after:absolute after:inset-0 focus-visible:outline-none">
                      {r.nama}
                    </a>
                  </h3>
                  <p class="text-sm text-on-surface-variant mt-1 leading-relaxed">{r.ringkas}</p>
                </div>
                <div class="pt-3 mt-4 border-t border-surface-container flex items-center justify-between text-xs text-text-muted">
                  <span>Jarak: {r.jarak}</span>
                  <span class="inline-flex items-center gap-1 text-primary font-semibold">
                    Lihat rute
                    <IconArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
