---
import { Image } from 'astro:assets';
import IconArrow from '@tabler/icons/outline/arrow-right.svg';
import ioniq from '../assets/cars/ioniq5.jpg';
import { site, WA_SOURCE_TAG, waLink } from '../config/site';

const { promo } = site;
const pesan = `Halo Admin ${site.name}, saya tertarik promo ${promo.car} (${promo.detail}). ${WA_SOURCE_TAG}`;
---

{
  promo.active && (
    <section class="w-full py-10 bg-surface" id="promo" aria-labelledby="promo-title">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
        <div class="relative w-full rounded-lg overflow-hidden bg-gradient-to-r from-on-background via-inverse-surface to-on-background shadow-2xl flex flex-col lg:flex-row items-center">
          <!-- Content Side -->
          <div class="p-6 lg:p-10 flex-1 flex flex-col gap-4 z-10">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-3.5 py-1 rounded-full bg-primary-container text-white text-xs uppercase font-bold tracking-wider">
                PROMO SPESIAL
              </span>
              <span class="px-3.5 py-1 rounded-full bg-emerald-conversion text-white text-xs font-bold">
                Diskon {promo.value}
              </span>
            </div>

            <h2 id="promo-title" class="font-extrabold text-[32px] leading-tight lg:text-5xl text-surface-bright tracking-tight">
              Coba mobil listrik, <br />
              <span class="text-primary-fixed">tanpa beli bensin</span>
            </h2>

            <p class="text-base leading-[26px] text-outline-variant max-w-lg">
              {promo.detail}. Nikmati sensasi berkendara mobil listrik modern dengan kabin senyap dan teknologi mutakhir.
            </p>

            <div class="pt-2 flex flex-wrap items-center gap-4">
              <a
                class="px-6 py-3.5 bg-primary-container hover:bg-primary text-white font-bold text-sm rounded-xl shadow-lg flex items-center gap-2 transition-all hover:scale-105 active:scale-95"
                href={waLink(pesan)}
                target="_blank"
                rel="noopener noreferrer"
              >
                Pesan {promo.car}
                <IconArrow class="w-4 h-4" aria-hidden="true" />
              </a>
              <span class="text-xs font-medium text-surface-container-high">Unit terbatas &bull; Booking sekarang</span>
            </div>
          </div>

          <!-- Electric Vehicle Image Showcase -->
          <div class="w-full lg:w-1/2 h-80 lg:h-[420px] relative overflow-hidden">
            <Image
              src={ioniq}
              alt={`${promo.car} putih tampak samping`}
              widths={[480, 720, 960]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-on-background via-transparent to-transparent pointer-events-none" />
          </div>
        </div>
      </div>
    </section>
  )
}
