---
/**
 * Placeholder peta tanpa gambar eksternal: pola grid + pin, klik membuka Google Maps (site.mapsUrl).
 */
import IconPin from '@tabler/icons/outline/map-pin.svg';
import IconExternal from '@tabler/icons/outline/external-link.svg';
import { site } from '../../config/site';

interface Props {
  label?: string;
  class?: string;
}

const { label = `Kawasan ${site.city} Tengah`, class: className } = Astro.props;
---

<a
  href={site.mapsUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Buka lokasi garasi ${site.name} di Google Maps`}
  class:list={[
    'map-ph group relative flex w-full items-end overflow-hidden rounded-xl bg-surface-container p-3 shadow-inner focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary',
    className,
  ]}
>
  <span class="map-grid absolute inset-0" aria-hidden="true"></span>
  <span class="map-road map-road-a absolute" aria-hidden="true"></span>
  <span class="map-road map-road-b absolute" aria-hidden="true"></span>
  <span class="absolute left-1/2 top-[42%] -translate-x-1/2 -translate-y-1/2 flex flex-col items-center" aria-hidden="true">
    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-primary text-white shadow-lg ring-4 ring-primary/20 transition-transform group-hover:scale-110">
      <IconPin class="h-6 w-6" />
    </span>
    <span class="mt-1 h-1.5 w-6 rounded-full bg-on-surface/20 blur-[1px]"></span>
  </span>
  <span class="absolute inset-0 bg-gradient-to-t from-on-surface/75 via-transparent to-transparent" aria-hidden="true"></span>
  <span class="relative z-10 flex w-full items-center justify-between gap-2 text-white">
    <span class="flex items-center gap-1.5 text-xs font-bold drop-shadow">
      <IconPin class="h-4 w-4 text-emerald-conversion" aria-hidden="true" />
      {label}
    </span>
    <span class="flex items-center gap-1 rounded-lg bg-surface-container-lowest/90 px-3 py-1.5 text-xs font-semibold text-primary shadow transition-colors group-hover:bg-surface-container-lowest">
      Buka Peta
      <IconExternal class="h-3.5 w-3.5" aria-hidden="true" />
    </span>
  </span>
</a>

<style>
  .map-grid {
    background-color: color-mix(in srgb, var(--color-primary, #0040a1) 4%, #eef2f7);
    background-image:
      linear-gradient(rgba(15, 23, 42, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .map-road {
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.05);
  }
  .map-road-a {
    left: -10%;
    right: -10%;
    top: 58%;
    height: 10px;
    transform: rotate(-8deg);
  }
  .map-road-b {
    top: -10%;
    bottom: -10%;
    left: 62%;
    width: 8px;
    transform: rotate(14deg);
  }
</style>
