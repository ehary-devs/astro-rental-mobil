---
import IconChevronDown from '@tabler/icons/outline/chevron-down.svg';
import IconWa from '@tabler/icons/outline/brand-whatsapp.svg';
import { kota } from '../data/halaman';
import { waGreeting, waLink } from '../config/site';

const faqs = [
  {
    q: 'Apa syarat sewa lepas kunci?',
    a: 'KTP dan SIM A yang masih berlaku, ditambah satu dokumen pendukung seperti KK, NPWP, atau ID karyawan. Kami juga meminta deposit yang dikembalikan saat mobil kembali.',
  },
  {
    q: 'Kalau dengan sopir, apa saja yang sudah termasuk?',
    a: 'Harga dengan sopir sudah termasuk mobil dan jasa sopir selama 12 jam. BBM, tol, parkir, dan makan sopir dibayar terpisah, kecuali Anda memilih paket all in.',
  },
  {
    q: 'Bagaimana cara bayar?',
    a: 'Transfer bank atau QRIS. DP 30% untuk mengunci jadwal, sisanya dilunasi saat serah terima mobil.',
  },
  {
    q: 'Boleh dibawa ke luar kota?',
    a: `Boleh, selama masih di Pulau Jawa dan Bali. Sebutkan tujuan saat memesan supaya kami siapkan mobil yang sesuai. Area utama kami ${kota.slice(0, 3).map((k) => k.nama).join(', ')}, dan sekitarnya.`,
  },
  {
    q: 'Kena biaya kalau telat mengembalikan?',
    a: 'Ada toleransi 1 jam. Setelah itu dihitung overtime 10% dari harga harian per jam. Lewat 5 jam dihitung satu hari penuh.',
  },
  {
    q: 'Bisa antar jemput ke bandara atau stasiun?',
    a: 'Bisa. Kami antar mobil atau jemput penumpang di Bandara Ahmad Yani, Stasiun Tawang, dan Stasiun Poncol. Biaya antar dalam kota gratis.',
  },
];
---

<section class="w-full py-10 bg-surface-subtle" id="faq" aria-labelledby="faq-title">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-10">
    <!-- Left Column Header -->
    <div class="lg:col-span-4 flex flex-col gap-2">
      <div class="flex flex-col gap-1">
        <span class="text-xs font-bold uppercase tracking-wider text-primary">TANYA JAWAB</span>
        <h2 id="faq-title" class="font-bold text-2xl leading-8 sm:text-[32px] sm:leading-10 text-on-surface tracking-tight">
          Pertanyaan yang sering muncul
        </h2>
        <p class="text-sm leading-[22px] text-on-surface-variant mt-1">
          Informasi seputar syarat sewa, penjemputan bandara, durasi, dan metode pembayaran.
        </p>
      </div>

      <div class="p-4 rounded-lg bg-surface-container-lowest shadow-sm flex flex-col gap-2 mt-4">
        <span class="font-semibold text-lg leading-6 text-on-surface">Butuh bantuan cepat?</span>
        <p class="text-xs text-on-surface-variant leading-relaxed">
          Admin kami siap menjawab pertanyaan dan cek ketersediaan unit secara langsung via WhatsApp.
        </p>
        <a
          class="inline-flex items-center justify-center gap-2 bg-emerald-conversion hover:bg-emerald-deep text-white py-2.5 px-4 rounded-md font-semibold text-sm transition-colors"
          href={waLink(waGreeting)}
          target="_blank"
          rel="noopener noreferrer"
        >
          <IconWa class="w-4 h-4" aria-hidden="true" />
          Tanya via WhatsApp
        </a>
      </div>
    </div>

    <!-- Right Column Accordions -->
    <div class="lg:col-span-8 flex flex-col gap-2">
      {
        faqs.map((f) => (
          <details class="faq-item group bg-surface-container-lowest rounded-lg shadow-sm overflow-hidden transition-all duration-200">
            <summary class="w-full p-4 flex items-center justify-between text-left font-semibold text-base sm:text-lg leading-6 text-on-surface hover:text-primary cursor-pointer list-none select-none transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary">
              <span>{f.q}</span>
              <IconChevronDown class="w-5 h-5 text-on-surface-variant group-open:rotate-180 transition-transform duration-200 shrink-0 ml-3" aria-hidden="true" />
            </summary>
            <div class="px-4 pb-4 text-sm text-on-surface-variant leading-relaxed">
              {f.a}
            </div>
          </details>
        ))
      }
      <div class="pt-2">
        <a href="/faq/" class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-primary-container transition-colors">
          <span>Lihat semua panduan &amp; tanya jawab operasional</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
