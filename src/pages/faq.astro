---
import IconHome from '@tabler/icons/outline/home.svg';
import IconSearch from '@tabler/icons/outline/search.svg';
import IconX from '@tabler/icons/outline/x.svg';
import IconArrowRight from '@tabler/icons/outline/arrow-right.svg';
import IconCreditCard from '@tabler/icons/outline/credit-card.svg';
import IconId from '@tabler/icons/outline/id.svg';
import IconGasStation from '@tabler/icons/outline/gas-station.svg';
import IconAlertTriangle from '@tabler/icons/outline/alert-triangle.svg';
import IconLifebuoy from '@tabler/icons/outline/lifebuoy.svg';
import IconPhone from '@tabler/icons/outline/phone.svg';
import IconWa from '@tabler/icons/outline/brand-whatsapp.svg';
import IconMapPin from '@tabler/icons/outline/map-pin.svg';
import IconChevronDown from '@tabler/icons/outline/chevron-down.svg';
import IconCheck from '@tabler/icons/outline/circle-check.svg';
import IconClipboard from '@tabler/icons/outline/clipboard-check.svg';
import IconKey from '@tabler/icons/outline/key.svg';
import IconClock from '@tabler/icons/outline/clock.svg';
import IconExternal from '@tabler/icons/outline/external-link.svg';
import IconCar from '@tabler/icons/outline/car.svg';
import Base from '../layouts/Base.astro';
import MapPlaceholder from '../components/kontak/MapPlaceholder.astro';
import { site, waLink, waGreeting, WA_SOURCE_TAG } from '../config/site';
import { kota } from '../data/halaman';

type CatId = 'booking' | 'syarat' | 'operasional' | 'darurat';

interface FaqItem {
  cat: CatId;
  q: string;
  /** Kata kunci tambahan untuk pencarian (tidak tampil). */
  keywords: string;
  intro?: string;
  list?: string[];
  ordered?: boolean;
  note?: string;
}

// TODO (pemilik usaha): sesuaikan jawaban dengan kebijakan asli. Isi diselaraskan dengan Syarat & Ketentuan.
const faqs: FaqItem[] = [
  {
    cat: 'booking',
    q: `Bagaimana tata cara pemesanan mobil dan sistem pembayaran di ${site.name}?`,
    keywords: 'reservasi booking pesan wa whatsapp dp uang muka pelunasan transfer qris pembayaran bayar',
    intro: 'Pemesanan dilakukan langsung lewat WhatsApp admin kami:',
    ordered: true,
    list: [
      'Pilih mobil, layanan (lepas kunci atau dengan sopir), tanggal mulai, dan durasi sewa.',
      'Kirim foto dokumen yang diperlukan untuk verifikasi.',
      'Bayar DP 30% lewat transfer bank atau QRIS untuk mengunci jadwal.',
      'Lunasi sisa biaya saat serah terima mobil.',
    ],
    note: `Pembayaran hanya ke rekening atas nama usaha atau QRIS resmi ${site.name}. Detailnya dikirim oleh admin resmi lewat WhatsApp ${site.phoneDisplay}.`,
  },
  {
    cat: 'booking',
    q: 'Apakah ada biaya tambahan untuk antar-jemput mobil di Bandara Ahmad Yani atau stasiun?',
    keywords: 'antar jemput bandara ahmad yani srg stasiun tawang poncol pengantaran gratis hotel rumah luar kota',
    intro: `Antar jemput mobil di dalam Kota ${site.city} gratis, termasuk ke:`,
    list: ['Bandara Ahmad Yani.', 'Stasiun Tawang dan Stasiun Poncol.', 'Rumah atau hotel Anda di dalam kota.'],
    note: 'Untuk pengantaran ke luar kota, biaya antar disesuaikan dengan jarak. Konfirmasi biayanya ke admin lewat WhatsApp.',
  },
  {
    cat: 'booking',
    q: 'Apakah saya bisa mengubah jadwal (reschedule) atau membatalkan pesanan sewa?',
    keywords: 'reschedule batal pembatalan jadwal ubah tanggal refund uang kembali ganti jadwal',
    intro: 'Bisa, dengan ketentuan berikut:',
    list: [
      'Ubah jadwal gratis sampai H-1, tergantung ketersediaan mobil di jadwal baru.',
      'Pembatalan H-1 atau lebih awal: DP dikembalikan 50%.',
      'Pembatalan di hari H: DP hangus.',
    ],
  },
  {
    cat: 'syarat',
    q: 'Apa saja persyaratan dokumen untuk sewa mobil sistem Lepas Kunci (Self-Drive)?',
    keywords: 'syarat lepas kunci self drive ktp sim a npwp kartu keluarga kk id karyawan dokumen deposit jaminan',
    list: [
      'KTP.',
      'SIM A yang masih aktif.',
      'Satu dokumen pendukung: KK, NPWP, atau ID karyawan.',
      'Deposit, yang dikembalikan penuh setelah mobil kembali tanpa kerusakan.',
    ],
    note: 'Dokumen asli cukup diperlihatkan saat serah terima. Kami tidak menyimpan dokumen asli Anda.',
  },
  {
    cat: 'syarat',
    q: 'Apakah bisa menyewa jika saya tidak memiliki kartu kredit?',
    keywords: 'tanpa kartu kredit deposit jaminan transfer qris debit',
    intro: `Bisa. ${site.name} tidak mewajibkan kartu kredit. Pembayaran dan deposit cukup lewat transfer bank atau QRIS.`,
    note: 'Besaran deposit untuk lepas kunci tergantung mobil yang dipilih. Tanyakan ke admin saat memesan.',
  },
  {
    cat: 'syarat',
    q: 'Kalau sewa dengan sopir, dokumen apa yang perlu disiapkan?',
    keywords: 'dengan sopir driver dokumen ktp pemesan alamat jemput',
    intro: 'Cukup KTP pemesan. Sertakan juga alamat penjemputan dan rencana rute supaya kami siapkan mobil dan sopir yang sesuai.',
  },
  {
    cat: 'operasional',
    q: 'Bagaimana aturan BBM, tol, dan parkir selama periode sewa?',
    keywords: 'bahan bakar bbm bensin tol etoll parkir makan sopir all in 12 jam',
    list: [
      'Dengan sopir: harga sudah termasuk mobil dan jasa sopir selama 12 jam. BBM, tol, parkir, dan makan sopir dibayar terpisah, kecuali Anda memilih paket all in.',
      'Lepas kunci: dihitung per 24 jam. BBM, tol, dan parkir selama pemakaian ditanggung penyewa.',
    ],
  },
  {
    cat: 'operasional',
    q: 'Berapa biaya denda keterlambatan pengembalian unit (overtime)?',
    keywords: 'overtime telat terlambat kembali denda per jam keterlambatan toleransi batas waktu',
    intro: 'Ada toleransi keterlambatan 1 jam. Setelah itu dihitung overtime 10% dari harga harian per jam. Lewat 5 jam dihitung satu hari penuh.',
  },
  {
    cat: 'operasional',
    q: 'Boleh dibawa ke luar kota?',
    keywords: 'luar kota mudik wisata jawa bali rute antar kota perjalanan jauh',
    intro: `Boleh, selama masih di Pulau Jawa dan Bali. Sebutkan tujuan saat memesan supaya kami siapkan mobil yang sesuai. Area utama kami ${kota
      .slice(0, 3)
      .map((k) => k.nama)
      .join(', ')}, dan sekitarnya.`,
  },
  {
    cat: 'darurat',
    q: 'Apa yang harus saya lakukan jika mobil mengalami kendala teknis atau mogok di jalan?',
    keywords: 'mogok rusak di jalan kendala teknis aki ban bocor darurat bantuan',
    ordered: true,
    list: [
      'Tepikan mobil ke tempat aman dan nyalakan lampu hazard.',
      `Hubungi admin lewat WhatsApp atau telepon ${site.phoneDisplay}, kirim lokasi dan foto kondisi mobil.`,
      'Ikuti arahan admin. Jangan memperbaiki atau membawa mobil ke bengkel tanpa koordinasi.',
    ],
  },
  {
    cat: 'darurat',
    q: 'Bagaimana jika terjadi baret kecil atau kecelakaan saat mobil digunakan?',
    keywords: 'baret lecet tabrakan kecelakaan kerusakan tilang etle tanggung jawab',
    intro: 'Segera kabari admin dan dokumentasikan kondisi mobil dengan foto. Penanganan dan biayanya akan dibicarakan sesuai kejadian.',
    note: 'Sesuai syarat & ketentuan, kerusakan akibat kelalaian dan tilang selama masa sewa menjadi tanggung jawab penyewa.',
  },
];

const countOf = (id: CatId) => faqs.filter((f) => f.cat === id).length;

const categories = [
  { id: 'all', label: 'Semua Topik', icon: IconLifebuoy, count: faqs.length },
  { id: 'booking', label: 'Reservasi & Pembayaran', icon: IconCreditCard, count: countOf('booking') },
  { id: 'syarat', label: 'Persyaratan & Dokumen', icon: IconId, count: countOf('syarat') },
  { id: 'operasional', label: 'Aturan Selama Sewa', icon: IconGasStation, count: countOf('operasional') },
  { id: 'darurat', label: 'Bantuan & Darurat', icon: IconAlertTriangle, count: countOf('darurat') },
];

const quickCards = [
  {
    cat: 'booking' as CatId,
    title: 'Reservasi & Bayar',
    desc: 'Cara booking lewat WhatsApp, DP 30%, pelunasan, dan perubahan jadwal.',
    icon: IconCreditCard,
    color: 'bg-primary-fixed text-primary group-hover:bg-primary group-hover:text-white',
  },
  {
    cat: 'syarat' as CatId,
    title: 'Syarat & Dokumen',
    desc: 'Dokumen lepas kunci, sewa dengan sopir, dan ketentuan deposit.',
    icon: IconId,
    color: 'bg-secondary-fixed text-on-secondary-fixed group-hover:bg-primary group-hover:text-white',
  },
  {
    cat: 'operasional' as CatId,
    title: 'Selama Perjalanan',
    desc: 'Aturan BBM, tol, overtime, dan pemakaian ke luar kota.',
    icon: IconGasStation,
    color: 'bg-tertiary-fixed text-tertiary group-hover:bg-tertiary group-hover:text-white',
  },
  {
    cat: 'darurat' as CatId,
    title: 'Bantuan Darurat',
    desc: 'Langkah saat mobil mogok, baret, atau terjadi kecelakaan.',
    icon: IconAlertTriangle,
    color: 'bg-error-container text-error group-hover:bg-error group-hover:text-white',
  },
];

const quickTags = ['Lepas Kunci', 'Bandara', 'Pembayaran', 'Luar Kota', 'Deposit', 'Overtime', 'Reschedule'];

const plain = (f: FaqItem) => [f.intro, ...(f.list ?? []), f.note].filter(Boolean).join(' ');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: plain(f) },
  })),
};

const steps = [
  {
    n: '01',
    title: 'Cek Dokumen',
    desc: 'Tunjukkan dokumen asli yang sebelumnya sudah difoto lewat WhatsApp. Dokumen langsung dikembalikan.',
    tag: 'Dokumen tidak ditahan',
    icon: IconId,
    tone: 'bg-primary text-white',
    tagTone: 'text-primary',
  },
  {
    n: '02',
    title: 'Cek Kondisi Mobil Bersama',
    desc: 'Periksa bodi, level BBM, kebersihan kabin, dan kelengkapan mobil bersama petugas. Foto kondisinya sebagai catatan bersama.',
    tag: 'Kondisi tercatat bersama',
    icon: IconClipboard,
    tone: 'bg-primary-container text-on-primary-container',
    tagTone: 'text-primary-container',
  },
  {
    n: '03',
    title: 'Pelunasan & Serah Kunci',
    desc: 'Lunasi sisa biaya sewa, terima kunci, dan mobil siap dipakai sesuai jadwal Anda.',
    tag: 'Langsung berangkat',
    icon: IconKey,
    tone: 'bg-emerald-conversion text-white',
    tagTone: 'text-emerald-deep',
  },
];
---

<Base
  title={`Pusat Bantuan & FAQ Rental Mobil | ${site.name} ${site.city}`}
  description={`Pusat bantuan & tanya jawab seputar sewa mobil ${site.name} ${site.city}. Info syarat lepas kunci, cara reservasi, antar jemput bandara, overtime, dan langkah saat darurat.`}
  offsetHeader
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="w-full bg-surface pb-16 lg:pb-24">
    <!-- Breadcrumb & status -->
    <section class="w-full bg-surface-container-low border-b border-border-subtle/50 py-3">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-on-surface-variant font-medium">
          <a class="hover:text-primary transition-colors flex items-center gap-1" href="/">
            <IconHome class="w-4 h-4" aria-hidden="true" />
            <span>Beranda</span>
          </a>
          <span class="text-outline-variant" aria-hidden="true">/</span>
          <span class="text-primary font-bold" aria-current="page">Pusat Bantuan &amp; FAQ</span>
        </nav>
        <div class="inline-flex items-center gap-2 bg-surface-container-lowest px-3.5 py-1.5 rounded-full shadow-sm text-xs font-semibold text-on-surface border border-border-subtle/60">
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-conversion opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-conversion"></span>
          </span>
          <span>Admin Siap Melayani {site.hours}</span>
        </div>
      </div>
    </section>

    <!-- Hero & pencarian -->
    <section class="relative w-full bg-surface-container-low overflow-hidden pt-12 sm:pt-16 pb-16 border-b border-border-subtle/50">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
        <div class="max-w-3xl mx-auto text-center flex flex-col items-center">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary-fixed text-on-primary-fixed font-bold text-xs mb-4 shadow-sm">
            <IconLifebuoy class="w-4 h-4 text-primary" aria-hidden="true" />
            <span>Pusat Bantuan Resmi {site.name} {site.city}</span>
          </span>
          <h1 class="font-extrabold text-3xl sm:text-4xl lg:text-5xl text-on-surface tracking-tight mb-4">Ada yang Bisa Kami Bantu?</h1>
          <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl mb-8 leading-relaxed">
            Cari panduan sewa, solusi kendala perjalanan di {site.city} &amp; Jawa Tengah, atau hubungi tim customer service kami yang siap membantu setiap hari.
          </p>

          <form id="faqSearchForm" role="search" class="w-full bg-surface-container-lowest p-2 rounded-2xl shadow-xl border border-border-subtle flex flex-col sm:flex-row items-center gap-2" action="#faqAccordionSection">
            <div class="flex items-center gap-3 w-full px-4 py-2.5 text-on-surface">
              <IconSearch class="w-5 h-5 text-primary shrink-0" aria-hidden="true" />
              <label for="faqSearchInput" class="sr-only">Cari pertanyaan</label>
              <input
                id="faqSearchInput"
                type="search"
                class="w-full bg-transparent border-0 outline-none text-sm text-on-surface placeholder:text-outline [&::-webkit-search-cancel-button]:hidden"
                placeholder="Cari pertanyaan, misal: syarat lepas kunci, overtime, jemput bandara..."
                autocomplete="off"
              />
              <button type="button" id="clearSearchBtn" class="hidden p-1 text-on-surface-variant hover:text-on-surface rounded-lg transition-colors cursor-pointer" aria-label="Bersihkan pencarian">
                <IconX class="w-4 h-4" aria-hidden="true" />
              </button>
            </div>
            <button type="submit" class="w-full sm:w-auto bg-primary hover:bg-primary-container text-white font-bold text-sm px-6 py-3 rounded-xl flex items-center justify-center gap-2 transition-colors shadow-md cursor-pointer shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
              Cari
              <IconArrowRight class="w-4 h-4" aria-hidden="true" />
            </button>
          </form>

          <div class="flex flex-wrap items-center justify-center gap-2 mt-5 text-xs">
            <span class="text-on-surface-variant font-medium">Populer:</span>
            {
              quickTags.map((tag) => (
                <button type="button" data-quick-tag={tag} class="px-3 py-1 rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface font-medium transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                  {tag}
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Kartu kategori cepat -->
    <section class="max-w-[1280px] mx-auto px-4 sm:px-6 w-full -mt-8 relative z-20" aria-label="Topik bantuan">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          quickCards.map((card) => (
            <button
              type="button"
              data-cat-trigger={card.cat}
              class="group text-left cursor-pointer bg-surface-container-lowest p-5 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border border-border-subtle flex flex-col justify-between gap-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              <span class="flex flex-col gap-3">
                <span class:list={['w-12 h-12 rounded-xl flex items-center justify-center transition-colors shadow-sm', card.color]}>
                  <card.icon class="w-6 h-6" aria-hidden="true" />
                </span>
                <span>
                  <span class="block font-bold text-base text-on-surface group-hover:text-primary transition-colors">{card.title}</span>
                  <span class="block text-xs text-on-surface-variant mt-1 leading-relaxed">{card.desc}</span>
                </span>
              </span>
              <span class="w-full pt-2 border-t border-border-subtle/50 flex items-center justify-between text-xs font-bold text-primary">
                <span>{countOf(card.cat)} Pertanyaan</span>
                <IconArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" />
              </span>
            </button>
          ))
        }
      </div>
    </section>

    <!-- Kategori + accordion -->
    <section class="max-w-[1280px] mx-auto px-4 sm:px-6 w-full py-16 scroll-mt-24" id="faqAccordionSection">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-4 flex flex-col gap-6 lg:sticky lg:top-28">
          <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-border-subtle flex flex-col gap-4">
            <div>
              <h2 class="font-bold text-lg text-on-surface">Kategori Pertanyaan</h2>
              <p class="text-xs text-on-surface-variant mt-1">Pilih kategori untuk memfilter jawaban seputar rental mobil kami.</p>
            </div>
            <div class="flex flex-col gap-1.5" id="categoryTabList">
              {
                categories.map((cat, idx) => (
                  <button
                    type="button"
                    data-cat-btn={cat.id}
                    aria-pressed={idx === 0 ? 'true' : 'false'}
                    class:list={[
                      'cat-nav-btn w-full text-left px-3.5 py-2.5 rounded-xl text-sm font-semibold flex items-center justify-between transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary',
                      idx === 0 ? 'bg-primary-fixed text-on-primary-fixed font-bold' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container',
                    ]}
                  >
                    <span class="flex items-center gap-2.5">
                      <cat.icon class="w-4 h-4 shrink-0" aria-hidden="true" />
                      <span>{cat.label}</span>
                    </span>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-surface-container-high/60 font-bold opacity-80">{cat.count}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <div class="hidden lg:flex bg-surface-container-low p-6 rounded-2xl border border-border-subtle flex-col gap-3">
            <div class="flex items-center gap-2 text-emerald-deep font-bold text-xs">
              <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-conversion opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-conversion"></span>
              </span>
              <span>Layanan Customer Care Aktif</span>
            </div>
            <h3 class="font-bold text-base text-on-surface">Pusat Bantuan {site.city}</h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              Pertanyaan Anda belum terjawab? Admin kami siap membantu lewat WhatsApp atau telepon di jam operasional.
            </p>
            <div class="pt-3 border-t border-border-subtle/60 flex flex-col gap-1.5 text-xs">
              <div class="flex items-center justify-between gap-3">
                <span class="text-on-surface-variant">Jam layanan:</span>
                <span class="font-bold text-on-surface">06.00 &ndash; 22.00 WIB</span>
              </div>
              <div class="flex items-center justify-between gap-3">
                <span class="text-on-surface-variant">WhatsApp:</span>
                <a href={waLink(waGreeting)} target="_blank" rel="noopener noreferrer" class="font-bold text-emerald-deep hover:underline">{site.phoneDisplay}</a>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-8 flex flex-col gap-4">
          <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-border-subtle/50">
            <div class="flex items-center gap-2">
              <IconLifebuoy class="w-5 h-5 text-primary" aria-hidden="true" />
              <h2 class="font-bold text-xl text-on-surface" id="currentTopicTitle">Semua Pertanyaan</h2>
            </div>
            <span class="text-xs text-on-surface-variant font-medium" id="resultCount" aria-live="polite">Menampilkan {faqs.length} pertanyaan</span>
          </div>

          <div class="flex flex-col gap-3" id="faqAccordionList">
            {
              faqs.map((f, i) => (
                <details
                  class="faq-item group bg-surface-container-lowest rounded-2xl border border-border-subtle shadow-sm overflow-hidden"
                  data-category={f.cat}
                  data-keywords={f.keywords}
                  open={i === 0}
                >
                  <summary class="w-full p-5 sm:p-6 flex items-center justify-between gap-3 text-left font-bold text-sm sm:text-base text-on-surface hover:text-primary cursor-pointer list-none select-none transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary rounded-2xl">
                    <span>{f.q}</span>
                    <IconChevronDown class="w-5 h-5 text-on-surface-variant group-open:rotate-180 transition-transform duration-200 shrink-0" aria-hidden="true" />
                  </summary>
                  <div class="px-5 sm:px-6 pb-6 text-sm text-on-surface-variant leading-relaxed border-t border-border-subtle/50 pt-4 flex flex-col gap-3">
                    {f.intro && <p>{f.intro}</p>}
                    {f.list &&
                      (f.ordered ? (
                        <ol class="list-decimal pl-5 space-y-1.5 text-on-surface">
                          {f.list.map((li) => <li>{li}</li>)}
                        </ol>
                      ) : (
                        <ul class="list-disc pl-5 space-y-1.5 text-on-surface">
                          {f.list.map((li) => <li>{li}</li>)}
                        </ul>
                      ))}
                    {f.note && <p class="bg-surface-container-low p-3.5 rounded-xl border border-border-subtle/60 text-xs text-on-surface">{f.note}</p>}
                  </div>
                </details>
              ))
            }
          </div>

          <div id="noFaqResults" class="hidden flex-col items-center justify-center p-8 sm:p-12 text-center bg-surface-container-lowest rounded-2xl border border-border-subtle mt-4">
            <div class="w-16 h-16 rounded-2xl bg-surface-container-high flex items-center justify-center mb-4">
              <IconSearch class="w-8 h-8 text-outline" aria-hidden="true" />
            </div>
