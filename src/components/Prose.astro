---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<article class="container prose">
  <h1 class="section-title">{title}</h1>
  <slot />
</article>

<style>
  .prose {
    max-width: calc(760px + var(--gutter) * 2);
    padding-bottom: clamp(64px, 9vw, 112px);
  }

  .prose :global(h2) {
    margin-top: 40px;
    font-size: 1.375rem;
    font-stretch: 110%;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 16px;
    color: var(--text-2);
  }

  .prose :global(li + li) {
    margin-top: 6px;
  }

  .prose :global(a) {
    color: var(--accent);
  }

  .prose :global(.updated) {
    font-size: 0.875rem;
  }
</style>
