---
/** FAQ per mobil. Jawaban mengikuti ketentuan yang sudah ada (Faq.astro, halaman.ts, syarat & ketentuan). */
import type { CollectionEntry } from 'astro:content';
import IconChevronDown from '@tabler/icons/outline/chevron-down.svg';
import { site } from '../../config/site';

interface Props {
  car: CollectionEntry<'armada'>;
}

const { car } = Astro.props;
const { nama, kapasitas, harga } = car.data;
const lk = Boolean(harga.lepasKunci);
const ds = Boolean(harga.denganSopir);

const faqs: { q: string; a: string }[] = [
  {
    q: `Apakah ${nama} bisa disewa lepas kunci atau dengan sopir?`,
    a:
      lk && ds
        ? `Bisa keduanya. Lepas kunci dihitung per 24 jam, dengan sopir dihitung per 12 jam. Pilih paket di form pemesanan, admin akan konfirmasi ketersediaan unit.`
        : ds
          ? `${nama} hanya disewakan dengan sopir, dihitung per 12 jam. Sopir kami berpengalaman dan hafal rute Jawa Tengah - DIY.`
          : `${nama} disewakan lepas kunci, dihitung per 24 jam. Mobil bisa diambil di garasi atau diantar ke alamat Anda.`,
  },
  {
    q: 'Apa saja syarat sewanya?',
    a: [
      lk && 'Untuk lepas kunci: KTP dan SIM A yang masih berlaku, ditambah satu dokumen pendukung seperti KK, NPWP, atau ID karyawan, serta deposit yang dikembalikan saat mobil kembali.',
      ds && 'Untuk sewa dengan sopir: cukup KTP pemesan dan informasi jadwal serta rute perjalanan.',
    ]
      .filter(Boolean)
      .join(' '),
  },
  {
    q: 'Apa saja yang sudah termasuk dalam harga?',
    a: [
      lk && 'Harga lepas kunci sudah termasuk mobil selama 24 jam; BBM, tol, dan parkir ditanggung penyewa.',
      ds && 'Harga dengan sopir sudah termasuk mobil dan jasa sopir selama 12 jam; BBM, tol, parkir, makan sopir, dan overtime dibayar terpisah.',
    ]
      .filter(Boolean)
      .join(' '),
  },
  {
    q: `Berapa orang yang muat di ${nama}?`,
    a: `${nama} memiliki ${kapasitas} kursi. Sebutkan jumlah penumpang dan bawaan saat memesan supaya admin bisa memastikan mobil ini cocok, atau menyarankan alternatif.`,
  },
  {
    q: 'Bagaimana perhitungan biaya jika terlambat mengembalikan (overtime)?',
    a: 'Ada toleransi 1 jam. Setelah itu dihitung overtime 10% dari harga harian per jam. Lewat 5 jam dihitung satu hari penuh.',
  },
  {
    q: 'Bagaimana cara booking dan pembayarannya?',
    a: `Isi form pemesanan di halaman ini lalu kirim lewat WhatsApp. Admin (aktif ${site.hours.replace('Setiap', 'setiap')}) mengecek ketersediaan dan mengirim harga final. Pembayaran lewat transfer bank atau QRIS, DP 30% untuk mengunci jadwal, sisanya dilunasi saat serah terima.`,
  },
];
---

<section class="w-full bg-surface-container-low py-14 lg:py-20" aria-labelledby="faq-detail-title">
  <div class="max-w-[900px] mx-auto px-4 sm:px-6">
    <div class="text-center mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-primary">Pusat bantuan</span>
      <h2 id="faq-detail-title" class="font-bold text-2xl sm:text-3xl text-on-surface tracking-tight mt-1">
        Pertanyaan Seputar Sewa {nama}
      </h2>
      <p class="text-sm sm:text-base text-on-surface-variant mt-2">Jawaban singkat untuk memudahkan rencana pemesanan Anda.</p>
    </div>

    <div class="flex flex-col gap-3">
      {
        faqs.map((f, i) => (
          <details class="faq group bg-surface-container-lowest rounded-2xl border border-border-subtle shadow-sm overflow-hidden" open={i === 0}>
            <summary class="w-full px-5 py-4 flex items-center justify-between gap-3 cursor-pointer list-none font-semibold text-base text-on-surface hover:text-primary transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary rounded-2xl">
              <span>{f.q}</span>
              <IconChevronDown class="w-5 h-5 shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-180" aria-hidden="true" />
            </summary>
            <div class="px-5 pb-5 pt-3 border-t border-surface-container text-sm text-on-surface-variant leading-relaxed">{f.a}</div>
          </details>
        ))
      }
    </div>

    <p class="text-sm text-text-muted text-center mt-6">
      Masih ada pertanyaan? Lihat <a href="/faq/" class="text-primary font-semibold underline">semua FAQ</a>.
    </p>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
