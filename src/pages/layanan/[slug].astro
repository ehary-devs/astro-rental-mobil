---
import type { GetStaticPaths } from 'astro';
import InfoPage from '../../components/InfoPage.astro';
import { layanan, type InfoPage as Page } from '../../data/halaman';
import { site } from '../../config/site';

export const getStaticPaths = (() => layanan.map((page) => ({ params: { slug: page.slug }, props: { page } }))) satisfies GetStaticPaths;

interface Props {
  page: Page;
}

const { page } = Astro.props;
const siblings = layanan.filter((p) => p.slug !== page.slug).map((p) => ({ href: `/layanan/${p.slug}/`, nama: p.nama }));
---

<InfoPage {page} parent="Layanan" title={`${page.judul} ${site.city} | ${site.name}`} {siblings} />
